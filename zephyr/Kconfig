menu "NUCODE Arduino Core"

config NUCODE_ARDUINO_CORE
	bool "NUCODE Arduino Core 런타임 활성화"
	depends on CPP
	depends on STD_CPP_VERSION >= 201703
	help
	  Loader 없이 하나의 Zephyr 애플리케이션 이미지에 Arduino 호환
	  setup()/loop() 런타임을 링크합니다. 이 옵션은 기본적으로 비활성화되며,
	  애플리케이션이 C++17 이상의 표준을 명시해야 합니다.

	  setup()/loop() 런타임 자체는 동적 메모리를 할당하지 않습니다.
	  ArduinoCore-API String을 활성화하면 별도로 제한된 common libc malloc
	  arena를 사용합니다. 그 밖의 힙 크기는 최종 애플리케이션의 Kconfig가
	  소유합니다. 예외와 RTTI의 기본 검증값은 비활성이지만 Core가
	  구조적으로 금지하지 않습니다.

if NUCODE_ARDUINO_CORE

rsource "config/core.Kconfig"

rsource "config/serial.Kconfig"

rsource "config/analog_fabric.Kconfig"

rsource "config/event.Kconfig"

rsource "config/stream.Kconfig"

rsource "config/system.Kconfig"

rsource "config/buses.Kconfig"

rsource "config/analog.Kconfig"

rsource "config/ble.Kconfig"

rsource "config/scheduler.Kconfig"

endif

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 8192 if NUCODE_ARDUINO_API

endmenu
