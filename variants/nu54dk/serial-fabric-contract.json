  "lifecycle": {
    "activation_order": [
      "Validate identity, profile, pin direction and electrical policy without changing hardware.",
      "Reserve serial block, pins, IRQ, power requirement and every DMA memory range in one lease.",
      "Snapshot GPIO state and transfer pins to the selected route.",
      "Apply runtime power and pinctrl, clear stale events and initialize the selected personality.",
      "Commit the lease and only then publish the active state."
    ],
    "deactivation_order": [
      "Reject new work and request a bounded cancel or stop.",
      "Wait for the documented terminal event and prove DMA no longer owns application memory.",
      "Disable shortcuts, publish-subscribe links, interrupts and the peripheral personality.",
      "Disconnect PSEL, release power mode, restore GPIO state and release the complete lease.",
      "Latch fail-closed if bounded shutdown or restoration cannot be proven."
    ],
    "dma_buffer_states": ["application-owned", "queued", "dma-owned", "completed", "cancelled", "error"],
    "callback_context": "bounded-isr-event-deferred-to-thread",
    "timeout_policy": "bounded-stop-then-fail-closed-reset-required"
  },
  "errata": [
    { "id": 7, "peripheral": "uarte", "obligation": "RX flush and empty FIFO accounting must not trust a stale RXD.AMOUNT value." },
    { "id": 8, "peripheral": "spim", "obligation": "MOSI corruption conditions and the pinned nrfx workaround state are covered by targeted transfer tests." },
    { "id": 21, "peripheral": "spim", "obligation": "The final MOSI transition condition is recorded and checked with a logic analyzer where applicable." },
    { "id": 54, "peripheral": "spis", "obligation": "SDO receives a known idle state so the erratum cannot leave it floating." },
    { "id": 105, "peripheral": "twim", "obligation": "Cancellation never disables TWIM during clock stretching; an unprovable stop requires reset before reuse." }
  ],
  "completion_gates": [
    "Every one of the 23 personality identities has a build, semantic and standalone HIL result.",
    "Every same-block personality pair fails atomically while one personality owns the block.",
