/**
 * @file app.overlay
 * @brief AC-02B DUT의 동적 Serial1, Wire, SPI, ADC와 PWM route를 선택합니다.
 *
 * SPDX-License-Identifier: MIT
 */

#include <nucode/nu54dk-arduino-connectors.dtsi>
#include <nucode/nu54dk-arduino-pins.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		nucode,arduino-wire = &i2c22;
		nucode,arduino-spi = &spi00;
		nucode,arduino-adc = &ac02b_hil_adc_input;
		nucode,arduino-pwm = &pwm_led1;
	};

	ac02b_hil_adc_input: arduino-adc-input {
		compatible = "nucode,arduino-adc-input";
		io-channels = <&adc 5>;
	};
};

&pinctrl {
	/** @brief PWM21 runtime route 설치 전 사용하는 안전한 초기 상태입니다. */
	ac02b_pwm21_default: ac02b_pwm21_default {
		group1 { psels = <NRF_PSEL(PWM_OUT0, 1, 14)>; };
	};
	ac02b_pwm21_sleep: ac02b_pwm21_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 14)>;
			low-power-enable;
		};
	};

	/** @brief PWM22 runtime route 설치 전 사용하는 안전한 초기 상태입니다. */
	ac02b_pwm22_default: ac02b_pwm22_default {
		group1 { psels = <NRF_PSEL(PWM_OUT0, 1, 10)>; };
	};
	ac02b_pwm22_sleep: ac02b_pwm22_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 10)>;
			low-power-enable;
		};
	};
};

&uart30 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&i2c22 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&spi00 {
	status = "okay";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;
};

&pwm20 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&pwm21 {
	status = "okay";
	pinctrl-0 = <&ac02b_pwm21_default>;
	pinctrl-1 = <&ac02b_pwm21_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;
};

&pwm22 {
	status = "okay";
	pinctrl-0 = <&ac02b_pwm22_default>;
	pinctrl-1 = <&ac02b_pwm22_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;
};

/** @brief NFC 전용 P1.2/P1.3을 온보드 BQ25186용 TWIM22 route로 전환합니다. */
&uicr { nfct-pins-as-gpios; };

/** @brief P1.12/AIN5를 12-bit ADC 시험 입력으로 사용합니다. */
&adc {
	channel@5 {
		zephyr,gain = "ADC_GAIN_1_4";
	};
};
