#include <nucode/nu54dk-arduino-pins.dtsi>
/ {
    chosen {
        /delete-property/ zephyr,console;
        /delete-property/ zephyr,shell-uart;
        /delete-property/ zephyr,uart-mcumgr;
        /delete-property/ zephyr,bt-mon-uart;
        /delete-property/ zephyr,bt-c2h-uart;
    };
};
&uart20 { status = "disabled"; };
&uart30 { status = "disabled"; };

/**
 * @brief 이 HIL은 DAP UART 분리 확인 후에만 P1.04~07을 외부 fixture로 사용합니다.
 * @note 일반 board 정책은 유지하며 capability는 DAP UART GPIO Kconfig 조건을 따릅니다.
 */
#define V04_DAP_GPIO_CAPS (NUCODE_PIN_CAP_INPUT | NUCODE_PIN_CAP_OUTPUT | NUCODE_PIN_CAP_ANALOG)
&arduino_p1_04
{
    nucode,capability-mask = <V04_DAP_GPIO_CAPS>;
    nucode,policy = <NUCODE_PIN_POLICY_CONDITIONAL_DAP_UART>;
    nucode,ownership = <NUCODE_PIN_OWNER_CONDITIONAL>;
};
&arduino_p1_05
{
    nucode,capability-mask = <V04_DAP_GPIO_CAPS>;
    nucode,policy = <NUCODE_PIN_POLICY_CONDITIONAL_DAP_UART>;
    nucode,ownership = <NUCODE_PIN_OWNER_CONDITIONAL>;
};
&arduino_p1_06
{
    nucode,capability-mask = <V04_DAP_GPIO_CAPS>;
    nucode,policy = <NUCODE_PIN_POLICY_CONDITIONAL_DAP_UART>;
    nucode,ownership = <NUCODE_PIN_OWNER_CONDITIONAL>;
};
&arduino_p1_07
{
    nucode,capability-mask = <V04_DAP_GPIO_CAPS>;
    nucode,policy = <NUCODE_PIN_POLICY_CONDITIONAL_DAP_UART>;
    nucode,ownership = <NUCODE_PIN_OWNER_CONDITIONAL>;
};
#undef V04_DAP_GPIO_CAPS

/* P1.2/P1.3 are NFC pads unless explicitly released to the PMIC GPIO route. */
&uicr { nfct-pins-as-gpios; };

/* nrfx SPIS needs a compatible node, but no Zephyr driver may claim its IRQ. */
&spi22 {
    compatible = "nordic,nrf-spis";
    /delete-property/ rx-delay-supported;
    /delete-property/ rx-delay;
    def-char = <0xff>;
    status = "disabled";
};
