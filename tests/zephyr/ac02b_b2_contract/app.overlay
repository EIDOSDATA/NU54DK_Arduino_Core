/**
 * @file app.overlay
 * @brief AC-02B B2 실제 peripheral route와 runtime PM 계약을 구성합니다.
 *
 * SPDX-License-Identifier: MIT
 */

#include <nucode/nu54dk-arduino-pins.dtsi>

/ {
	chosen {
		nucode,arduino-wire = &i2c22;
		nucode,arduino-spi = &spi00;
	};
};

&uart30 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&i2c22 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&spi00 {
	status = "okay";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;
};

/** @brief NFC 전용 P1.2/P1.3을 TWIM22 route로 사용할 수 있게 전환합니다. */
&uicr { nfct-pins-as-gpios; };
