/**
 * @file app.overlay
 * @brief AC-02B peer의 uart30, TWIS21 target과 capture GPIO를 구성합니다.
 *
 * SPDX-License-Identifier: MIT
 */

&pinctrl {
	ac02b_twis21_default: ac02b_twis21_default {
		group1 {
			psels = <NRF_PSEL(TWIS_SDA, 1, 2)>,
				<NRF_PSEL(TWIS_SCL, 1, 3)>;
			bias-pull-up;
		};
	};

	ac02b_twis21_sleep: ac02b_twis21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIS_SDA, 1, 2)>,
				<NRF_PSEL(TWIS_SCL, 1, 3)>;
			low-power-enable;
		};
	};
};

&uart30 {
	status = "okay";
};

/** @brief Arduino Wire target 미지원 대신 독립 serial21을 TWIS target으로 사용합니다. */
&i2c21 {
	compatible = "nordic,nrf-twis";
	pinctrl-0 = <&ac02b_twis21_default>;
	pinctrl-1 = <&ac02b_twis21_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ zephyr,pm-device-runtime-auto;
	status = "okay";
};

/** @brief 같은 P1.2/P1.3을 구동할 수 있는 TWIM22는 peer에서 비활성화합니다. */
&i2c22 {
	status = "disabled";
};

/** @brief peer는 PWM을 출력하지 않고 P1.14 GPIO edge만 capture합니다. */
&pwm20 {
	status = "disabled";
};

/** @brief NFC 전용 P1.2/P1.3을 TWIS21 route로 전환합니다. */
&uicr { nfct-pins-as-gpios; };
