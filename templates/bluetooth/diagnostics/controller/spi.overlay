/** @brief SPI slave/IRQ의 실제 결선을 별도 확인한 외부 Host 전용 경로. */
&uart30 { status = "disabled"; };
/ { chosen { /delete-property/ zephyr,bt-c2h-uart; }; };
&pinctrl
{
    diag_spis_pins: diag_spis_pins
    {
        group1
        {
            psels = <NRF_PSEL(SPIS_SCK, 2, 1)>, <NRF_PSEL(SPIS_MOSI, 2, 2)>,
                    <NRF_PSEL(SPIS_MISO, 2, 4)>, <NRF_PSEL(SPIS_CSN, 2, 0)>;
        };
    };
};
&spi00
{
    compatible = "nordic,nrf-spis";
    /delete-property/ rx-delay-supported;
    /delete-property/ rx-delay;
    status = "okay";
    def-char = <0>;
    pinctrl-0 = <&diag_spis_pins>;
    /delete-property/ pinctrl-1;
    pinctrl-names = "default";
    bt-hci@0
    {
        compatible = "zephyr,bt-hci-spi-slave";
        reg = <0>;
        irq-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
    };
};
