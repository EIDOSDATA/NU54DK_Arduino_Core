/** @brief 외부 Host와 TX/RX·REQ/RDY handshake를 사용하는 저전력 UART. */
&pinctrl
{
    diag_lpuart_pins: diag_lpuart_pins
    {
        group1 { psels = <NRF_PSEL(UART_TX, 0, 0)>, <NRF_PSEL(UART_RX, 0, 1)>; };
    };
};
&uart30
{
    /delete-property/ hw-flow-control;
    pinctrl-0 = <&diag_lpuart_pins>;
    /delete-property/ pinctrl-1;
    pinctrl-names = "default";
    lpuart: diag_lpuart: nrf-sw-lpuart
    {
        compatible = "nordic,nrf-sw-lpuart";
        status = "okay";
        req-pin = <2>;
        rdy-pin = <3>;
    };
};
/ { chosen { zephyr,bt-c2h-uart = &diag_lpuart; }; };
